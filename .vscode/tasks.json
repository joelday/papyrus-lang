{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      // Builds the new RxJS/inversify-free extension (papyrus-lang-vscode2)
      // via its own npm scripts (tsc + eslint + esbuild). Used as the
      // preLaunchTask for "Launch papyrus-lang-vscode2" in launch.json.
      "label": "buildExtension2",
      "type": "npm",
      "script": "compile",
      "path": "src/papyrus-lang-vscode2",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      // Builds papyrus-lang-vscode2, then opens an Extension Development
      // Host with the extension host inspector on 127.0.0.1:9333 (without
      // pausing). Used by the "attach workaround" config in launch.json.
      "label": "launchDevHost2",
      "type": "process",
      "command": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/papyrus-lang-vscode2",
        "--inspect-extensions=9333",
        "--disable-extension=joelday.papyrus-lang-vscode",
        "--new-window"
      ],
      "dependsOn": "buildAll2",
      "problemMatcher": []
    },
    {
      // Publishes the NativeAOT Papyrus.LanguageServer into
      // src/papyrus-lang-vscode2/bin/<rid>/, where the extension looks for
      // it. ~20s when nothing changed (the AOT link always reruns).
      "label": "buildServer2",
      "type": "npm",
      "script": "build-server",
      "path": "src/papyrus-lang-vscode2",
      "problemMatcher": ["$msCompile"]
    },
    {
      // Everything the dev host runs: the extension bundle and the bundled
      // language server. Every papyrus-lang-vscode2 launch runs this, so the
      // dev host never picks up a stale build of either.
      "label": "buildAll2",
      "dependsOn": ["buildExtension2", "buildServer2"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }

    // --- Legacy papyrus-lang-vscode (RxJS/inversify) build tasks below,
    // --- disabled while papyrus-lang-vscode2 is under active development.
    /*
    ,{
      "label": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "windows": {
        "command": "dotnet",
        "args": [
          "cake"
        ]
      },
      "problemMatcher": ["$tsc", "$msCompile"]
    },
    {
      "label": "updateBin",
      "windows": {
        "command": "dotnet",
        "args": [
          "cake",
          "--target=\"update-bin\""
        ]
      },
      "command": "./build.sh",
      "args": ["--target=\"update-bin\""],
      "problemMatcher": ["$tsc", "$msCompile"]
    },
    {
      "label": "buildExtension",
      "windows": {
        "command": "dotnet",
        "args": [
          "cake",
          "--target=\"build-extension\""
        ]
      },
      "command": "./build.sh",
      "args": ["--target=\"build-extension\""],
      "problemMatcher": ["$tsc", "$msCompile"]
    }
    */
  ]
}

