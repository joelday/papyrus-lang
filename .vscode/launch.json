{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // The new RxJS/inversify-free extension (P4.06a/b rewrite). This is
      // the one to use for day-to-day trying-out; it builds via esbuild
      // (fast) and requires no .NET build of the old extension's bin/ tree.
      "name": "Launch papyrus-lang-vscode2",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "preLaunchTask": "buildExtension2",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/papyrus-lang-vscode2",
        // The installed Marketplace extension also claims .psc files.
        "--disable-extension=joelday.papyrus-lang-vscode"
      ],
      "outFiles": ["${workspaceFolder}/src/papyrus-lang-vscode2/dist/**/*.js"]
    },
    {
      // Workaround for https://github.com/microsoft/vscode/issues/336270:
      // the extensionHost launch above pauses the dev host's extension host
      // (--inspect-brk on 127.0.0.1) and js-debug then fails to attach via
      // ::1, so the dev host hangs. Instead, launchDevHost2 opens the dev
      // host with a non-breaking inspector, and this attaches to it over
      // IPv4 explicitly. Breakpoints hit during early activation may be
      // missed.
      "name": "Launch papyrus-lang-vscode2 (attach workaround)",
      "type": "node",
      "request": "attach",
      "preLaunchTask": "launchDevHost2",
      "address": "127.0.0.1",
      "port": 9333,
      "timeout": 30000,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/src/papyrus-lang-vscode2/dist/**/*.js"]
    }

    // --- Legacy papyrus-lang-vscode (RxJS/inversify) configs below,
    // --- disabled while papyrus-lang-vscode2 is under active development.
    // --- Re-enable (uncomment each block below and restore the leading
    // --- comma) if you need to debug the old extension that is still what
    // --- ships.
