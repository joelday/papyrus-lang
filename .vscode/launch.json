{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // The new RxJS/inversify-free extension (P4.06a/b rewrite). This is
      // the one to use for day-to-day trying-out; it builds via esbuild
      // (fast) and requires no .NET build of the old extension's bin/ tree.
      "name": "Launch papyrus-lang-vscode2",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "preLaunchTask": "buildExtension2",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/papyrus-lang-vscode2"
      ],
      "outFiles": ["${workspaceFolder}/src/papyrus-lang-vscode2/dist/**/*.js"]
    }

    // --- Legacy papyrus-lang-vscode (RxJS/inversify) configs below,
    // --- disabled while papyrus-lang-vscode2 is under active development.
    // --- Re-enable (uncomment each block below and restore the leading
