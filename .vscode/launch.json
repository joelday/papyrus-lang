{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      // Builds the extension (esbuild) and the language server, then opens
      // an Extension Development Host.
      "name": "Launch papyrus-lang-vscode",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "preLaunchTask": "buildAll",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/src/papyrus-lang-vscode",
      ],
      "outFiles": ["${workspaceFolder}/src/papyrus-lang-vscode/dist/**/*.js"]
    }
  ]
}
