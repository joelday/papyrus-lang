<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>papyrusc</AssemblyName>
    <RootNamespace>Papyrus.Compiler</RootNamespace>
    <!-- RID is passed at publish (CI smokes win-x64). Do not bake RuntimeIdentifier. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Papyrus.Workspaces\Papyrus.Workspaces.csproj" />
    <ProjectReference Include="..\Papyrus.CodeAnalysis\Papyrus.CodeAnalysis.csproj" />
    <ProjectReference Include="..\Papyrus.CodeAnalysis.Testing\Papyrus.CodeAnalysis.Testing.csproj" />
    <ProjectReference Include="..\Papyrus.Pex\Papyrus.Pex.csproj" />
    <InternalsVisibleTo Include="Papyrus.Compiler.Tests" />
  </ItemGroup>
</Project>
