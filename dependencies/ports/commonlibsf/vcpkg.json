{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/master/docs/vcpkg.schema.json",
  "name": "commonlibsf",
  "version-date": "2026-07-24",
  "port-version": 0,
  "description": "A reverse-engineered library for developing SFSE plugins for Starfield.",
  "homepage": "https://github.com/libxse/commonlibsf",
  "license": "GPL-3.0-or-later",
  "supports": "windows & x64",
  "dependencies": [
    "spdlog",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "xbyak": {
      "description": "xbyak trampoline support (required for DebugServer instruction hooks)",
      "dependencies": ["xbyak"]
    }
  }
}
